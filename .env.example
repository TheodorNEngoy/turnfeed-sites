# Reference only: build and preview do not load this file.
# Local tests/preview use mock moderation and disposable storage; no keys needed.
# Configure these as secrets in your own Sites project for a hosted deployment.
TURNFEED_SITE_SECRET=
OPENAI_API_KEY=
# Optional: comma-separated derived 40-character account keys. Keep private.
TURNFEED_OPERATOR_ACCOUNT_KEYS=
# Leave disabled. See docs/deployment.md for temporary owner-private setup.
TURNFEED_OPERATOR_SETUP=0
